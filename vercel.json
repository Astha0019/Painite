{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/customize",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/men",
      "destination": "/index.html"
    },
    {
      "source": "/women",
      "destination": "/index.html"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__route__="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route__=$1"
    }
  ]
}
