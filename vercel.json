{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__route__=$1"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api|admin|static|panite_files).*)",
      "destination": "/index.html"
    }
  ]
}
