# ==============================================================================
# PAINITE ATELIER — ENVIRONMENT TEMPLATE
# ==============================================================================

# Core Application Secrets
SECRET_KEY=your-production-secret-key-here
PORT=5000
HOST=127.0.0.1

# ==============================================================================
# META WHATSAPP BUSINESS CLOUD API CONFIGURATION
# Official Documentation: https://developers.facebook.com/docs/whatsapp/cloud-api
# ==============================================================================

# 1. Your Business WhatsApp Number (Receives order alerts)
WHATSAPP_BUSINESS_NUMBER=919359615919

# 2. Meta WhatsApp Phone Number ID (From Meta Developers Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 3. Meta WhatsApp Cloud API Access Token
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# 4. Meta Graph API Version
WHATSAPP_API_VERSION=v21.0

# 5. Approved Meta Message Template Name (Optional)
WHATSAPP_TEMPLATE_NAME=
